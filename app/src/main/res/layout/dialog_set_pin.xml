<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_margin="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:letterSpacing="0.15"
        android:text="WATCH PAIRING PIN"
        android:textColor="#3B82F6"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="Enter a 4-6 digit PIN. Untrusted watches must enter this PIN to connect to your phone."
        android:textColor="@color/ig_text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="24dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <EditText
            android:id="@+id/etPinCode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:fontFamily="monospace"
            android:hint="••••••"
            android:textColorHint="#475569"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:gravity="center"
            android:letterSpacing="0.5"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelPin"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/inter"
            android:text="CANCEL"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:background="@null"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSavePin"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter"
            android:text="SAVE PIN"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#3B82F6"
            android:background="@null"/>
    </LinearLayout>
</LinearLayout>